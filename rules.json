{
  "calendars": [
    {
      "file": "konstruktionsmetodik.ics",
      "name": "Konstruktionsmetodik",
      "match": "^TMKA05"
    },
    {
      "file": "mekanik-statik.ics",
      "name": "Mekanik - Statik",
      "match": "^TMME13"
    },
    {
      "file": "miljoteknik.ics",
      "name": "Miljöteknik",
      "match": "^TKMJ24"
    }
  ],
  "rules": [
    {
      "field": "SUMMARY",
      "pattern": "^TMKA05\\\\, ([^\\\\,]+)(\\\\,.*)?$",
      "replace": "Konstruktionsmetodik: \\1"
    },
    {
      "field": "SUMMARY",
      "pattern": "^TMME13\\\\, ([^\\\\,]+)(\\\\,.*)?$",
      "replace": "Mekanik - Statik: \\1"
    },
    {
      "field": "SUMMARY",
      "pattern": "^TKMJ24\\\\, ([^\\\\,]+)(\\\\,.*)?$",
      "replace": "Miljöteknik: \\1"
    },
    {
      "field": "SUMMARY",
      "pattern": ": FÖ$",
      "replace": ": Föreläsning"
    },
    {
      "field": "SUMMARY",
      "pattern": ": LE$",
      "replace": ": Lektion"
    },
    {
      "field": "SUMMARY",
      "pattern": ": LAB$",
      "replace": ": Laboration"
    },
    {
      "field": "SUMMARY",
      "pattern": ": SEM$",
      "replace": ": Seminarium"
    },
    {
      "field": "SUMMARY",
      "pattern": ": TEN$",
      "replace": ": Tentamen"
    }
  ]
}
